#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <locale/keys_fr.h>
/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |  BSP  |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  M  |  ESC  |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  ,   |  ;  |  :  |  !  | SHIFT |
            //                    | GUI | LWR | RWR |   | ENT | SPACE| ALT |

            bindings = <
&kp TAB     &kp FR_A  &kp FR_Z  &kp FR_E     &kp FR_R  &kp FR_T        &kp FR_Y    &kp FR_U  &kp FR_I      &kp FR_O          &kp FR_P          &kp BSPC
&kp LCTRL  &kp FR_Q  &kp FR_S  &kp FR_D     &kp FR_F  &kp FR_G        &kp FR_H    &kp FR_J  &kp FR_K      &kp FR_L          &kp FR_M  &kp ESC
&kp LSHIFT	&kp FR_W  &kp FR_X  &kp FR_C     &kp FR_V  &kp FR_B        &kp FR_COMMA    &kp FR_N  &kp FR_SEMICOLON  &kp FR_COLON  &kp FR_EXCLAMATION  &kp RSHIFT
                          &kp LGUI  &mo 1  &mo 2    &kp RET  &kp SPACE &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  &  |  -  |  _  |  =  |  $  |   | BT_CLR|   tg1 |  UP  |  tg2  |      |      |
            // | CTRL |  é  |  è  |  à  |  ç  |  ù  | 	|    	| LEFT	| DOWN | RIGHT |      |      |
            // | SHFT |  ¨  |  <  |     |     |     |   |  BT1  |  BT2  | BT3  |  BT4  |      | CAPS |
            //                    | GUI |     |     |   | ENT   | SPACE |  ALT |

            bindings = <
&kp TAB   	&kp FR_AMPERSAND    &kp FR_MINUS    &kp FR_UNDERSCORE   &kp FR_EQUAL  		&kp FR_DOLLAR   &bt BT_CLR  	&tog 1    		&kp UP_ARROW    &tog 2	  		&trans  &trans
&trans		&kp FR_E_ACUTE 		&kp FR_E_GRAVE  &kp FR_A_GRAVE   	&kp FR_C_CEDILLA   	&kp FR_U_GRAVE  &trans   		&kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW &trans  &trans
&kp LSHFT   &kp FR_UMLAUT       &kp FR_LESS_THAN   &trans     		&trans        		&trans          &bt BT_SEL 1  	&bt BT_SEL 2  	&bt BT_SEL 3 	&bt BT_SEL 4 	&trans  &kp CAPS
												&kp LGUI            &trans            	&trans        	&trans      	&trans       	&trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  (  |  )  |  %  |   |  <  |  7  |  8  |  9  |  ²  |      |
            // | CTRL |  +  |  *  |  [  |  ]  |  '  |   |  #  |  4  |  5  |  6  |  .  |      |
            // | SHFT |  -  |  /  |  {  |  }  |  "  |   |  *  |  1  |  2  |  3  |  ,  |      |
            //                    | GUI |     |     |   |     |     | 0 | 

            bindings = <
&kp TAB    &kp FR_EXCLAMATION   &kp FR_AT_SIGN  &kp FR_LEFT_PARENTHESIS  &kp FR_RIGHT_PARENTHESIS  &kp FR_PERCENT  			&kp FR_LESS_THAN 	&kp FR_N7  &kp FR_N8  &kp FR_N9  &kp FR_SUPER2 	&trans
&kp LCTRL  &kp FR_PLUS   		&kp FR_ASTERISK &kp FR_LEFT_BRACKET      &kp FR_RIGHT_BRACKET      &kp FR_SQT      			&kp FR_HASH    	 	&kp FR_N4  &kp FR_N5  &kp FR_N6  &kp FR_DOT		&trans
&kp LSHFT  &kp FR_MINUS  		&kp FR_SLASH    &kp FR_LEFT_BRACE        &kp FR_RIGHT_BRACE        &kp FR_DOUBLE_QUOTES 	&kp FR_ASTERISK  	&kp FR_N1  &kp FR_N2  &kp FR_N3  &kp FR_COMMA   &trans
													&kp LGUI    			&trans           			&trans    		&trans    		&trans       		&kp FR_N0
            >;
        };
    };
};
